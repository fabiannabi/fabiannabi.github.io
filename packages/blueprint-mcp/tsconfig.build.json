{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022"],
    "declaration": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
